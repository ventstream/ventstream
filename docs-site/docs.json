{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "VentStream",
  "description": "Operational data streaming for change-data capture, joined projections, native WebSockets, GraphQL subscriptions, and managed engine fleets.",
  "colors": {
    "primary": "#2FCF88",
    "light": "#50DCA0",
    "dark": "#24B978"
  },
  "logo": {
    "light": "/images/ventstream-logo-light.svg",
    "dark": "/images/ventstream-logo-dark.svg",
    "href": "https://ventstream.dev"
  },
  "favicon": "/images/favicon.svg",
  "seo": {
    "metatags": {
      "canonical": "https://ventstream.dev/docs"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "icon": "flag-checkered",
            "pages": [
              "introduction",
              "install",
              "quickstart",
              "concepts/architecture"
            ]
          },
          {
            "group": "Concepts",
            "icon": "lightbulb",
            "pages": [
              "concepts/managed-mode",
              "concepts/cdc-and-projections",
              "concepts/lifecycle-phases",
              "concepts/pause-resume-drain",
              "concepts/reconciliation",
              "concepts/fan-out",
              "concepts/performance"
            ]
          },
          {
            "group": "Connectors",
            "icon": "plug",
            "pages": [
              "connectors/overview",
              {
                "group": "Sources",
                "icon": "database",
                "pages": [
                  "connectors/sources/postgres",
                  "connectors/sources/supabase",
                  "connectors/sources/mysql",
                  "connectors/sources/mongodb",
                  "connectors/sources/neo4j",
                  "connectors/sources/kafka"
                ]
              },
              {
                "group": "Sinks",
                "icon": "magnifying-glass",
                "pages": [
                  "connectors/sinks/opensearch",
                  "connectors/sinks/meilisearch",
                  "connectors/sinks/redis"
                ]
              }
            ]
          },
          {
            "group": "Real-time",
            "icon": "tower-broadcast",
            "pages": [
              "concepts/real-time-subscriptions",
              "concepts/realtime-brokers",
              "guides/realtime-demo",
              "guides/reliable-apollo-subscriptions"
            ]
          },
          {
            "group": "Deploy",
            "icon": "server",
            "pages": [
              "deploy/local",
              "deploy/native-binary",
              "deploy/kubernetes",
              "deploy/kubernetes-standalone",
              "deploy/kubernetes-managed-engine"
            ]
          },
          {
            "group": "Guides",
            "icon": "map",
            "pages": [
              "guides/authoring-specs",
              "guides/database-tls",
              "guides/mcp-server",
              "guides/testing"
            ]
          },
          {
            "group": "Deep dives",
            "icon": "water",
            "pages": [
              "engineering/neo4j-hot-nodes"
            ]
          },
          {
            "group": "Reference",
            "icon": "bookmark",
            "pages": [
              "reference/engine-env",
              "reference/troubleshooting"
            ]
          }
        ]
      },
      {
        "tab": "Data migration",
        "icon": "truck-fast",
        "groups": [
          {
            "group": "Migration",
            "icon": "truck-fast",
            "pages": [
              "guides/zero-downtime-migration",
              "guides/one-time-migration"
            ]
          }
        ]
      },
      {
        "tab": "VentStream Cloud",
        "icon": "cloud",
        "groups": [
          {
            "group": "VentStream Cloud",
            "icon": "cloud",
            "pages": [
              "fleet/overview",
              "fleet/resource-model",
              "fleet/authentication",
              "fleet/enrollment",
              "fleet/configuration",
              "fleet/security"
            ]
          },
          {
            "group": "CLI",
            "icon": "terminal",
            "pages": [
              "fleet/cli"
            ]
          },
          {
            "group": "API",
            "icon": "code",
            "pages": [
              "reference/control-plane-api"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Blog",
        "href": "https://ventstream.dev/blog",
        "icon": "newspaper"
      },
      {
        "label": "Dashboard",
        "href": "https://ventstream.dev/dashboard",
        "icon": "grid-2"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/ventstream/ventstream",
