  "appearance": {
    "default": "dark"
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "dark": "#0B120F",
      "light": "#FFFFFF"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "dark"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "fonts": {
    "heading": {
      "family": "Inter"
    },
    "body": {
      "family": "Inter"
    }
  }
}
